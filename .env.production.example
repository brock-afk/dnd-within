# Production settings: copy to /opt/dnd-within/.env on the server and fill in every value.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# The address the site is served at; Caddy gets its HTTPS certificate for this name.
DOMAIN=dnd.example.com

# Signs login sessions. Changing it logs everyone out.
SECRET_KEY=
# Registering needs this code. Give it to friends; the DM's share link needs no account.
INVITE_CODE=

DB_NAME=dnd_within
DB_USER=dnd
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Login cookies only over HTTPS (docker-compose.prod.yml also sets this).
SESSION_HTTPS_ONLY=true
